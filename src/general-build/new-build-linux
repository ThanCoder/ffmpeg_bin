make distclean

CFLAGS="-Os -ffunction-sections -fdata-sections" \
LDFLAGS="-Wl,--gc-sections" \
./configure \
  --prefix="$PWD/build/linux" \
  --enable-gpl \
  --enable-version3 \
  --enable-static \
  --disable-shared \
  --disable-doc \
  --disable-libonnxruntime \
  --disable-libopenvino \
  --disable-libtensorflow \
  --disable-libtorch \
  --enable-swscale \
  --enable-avdevice \
  --enable-network \
  --enable-pthreads


make -j$(nproc)
make install